<?xml version="1.0" encoding="utf-8"?>
<!-- 排版与配色放在 Base 里，深色只覆盖状态栏图标明暗，两套模式字体一致。 -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Tessera" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_forest</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent_forest</item>
        <item name="colorError">@color/status_danger</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>

        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Tessera.BodySmall</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Tessera.BodyMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Tessera.BodyLarge</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Tessera.TitleSmall</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Tessera.TitleMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Tessera.TitleLarge</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Tessera.HeadlineSmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Tessera.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Tessera.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Tessera.LabelSmall</item>
        <item name="android:textViewStyle">@style/Widget.Tessera.TextView</item>
    </style>

    <style name="Theme.Tessera" parent="Base.Theme.Tessera">
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- 通知栏「同步剪贴板」落地页：全透明、无动画，只为短暂拿到焦点读一次剪贴板。 -->
    <style name="Theme.Tessera.Transparent" parent="Theme.Tessera">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

</resources>
