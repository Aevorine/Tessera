<?xml version="1.0" encoding="utf-8"?>
<!-- 排版：内置 Tessera Serif（中文宋体 / 英文与标点 Times New Roman）。正文小四 16sp，功能名称四号 19sp。 -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="TextAppearance.Tessera.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight" tools:targetApi="28">26sp</item>
    </style>

    <style name="TextAppearance.Tessera.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight" tools:targetApi="28">26sp</item>
    </style>

    <style name="TextAppearance.Tessera.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight" tools:targetApi="28">26sp</item>
    </style>

    <style name="TextAppearance.Tessera.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">19sp</item>
        <item name="android:lineHeight" tools:targetApi="28">30sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Tessera.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">19sp</item>
        <item name="android:lineHeight" tools:targetApi="28">30sp</item>
    </style>

    <style name="TextAppearance.Tessera.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight" tools:targetApi="28">30sp</item>
    </style>

    <style name="TextAppearance.Tessera.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="TextAppearance.Tessera.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 徽章类装饰标签，允许低于小四。 -->
    <style name="TextAppearance.Tessera.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Tessera.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/tessera_serif</item>
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.Tessera.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">@font/tessera_serif</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
