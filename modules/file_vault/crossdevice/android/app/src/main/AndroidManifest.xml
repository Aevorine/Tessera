<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 局域网直连所需。INTERNET 是 socket 的前提，另外两个用于 mDNS 组播：
         不持有组播锁的话，Wi-Fi 芯片在省电时会把组播帧丢掉，设备发现就时灵时不灵。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 前台服务：设备要能"断联后自动连回来"，进程就必须活着。
         Android 14 起必须声明与实际用途相符的 serviceType，否则启动即抛异常。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 前台服务本身杀不掉进程，但小米/华为/OPPO/vivo 这类系统的省电策略会无视
         前台服务状态直接冻结或杀死后台进程——这才是"退出界面就断联"的真正病根，
         而不是 Service 生命周期。用户要手动同意豁免，这里只是拿到发起入口的权限。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 扫码配对。声明为非必需：没有摄像头的设备（部分平板）照样能用
         「出示我的码」让对方来扫，不该被应用商店从可安装列表里排除掉。 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 应用内更新：下载完 APK 后交给系统装。系统仍会弹自己的确认框，
         这个权限只是让「允许安装未知应用」那个开关能对本应用打开。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Tessera 跨设备"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tessera">

        <!-- label 和 icon 必须显式写在 activity 上，不能只写在 application 上。
             系统分享面板（ChooserActivity）渲染每个候选项用的是**activity 的**
             label 和 icon；activity 上没有时，条目要么是空白、要么被降权到
             用户翻不到的地方——表现就是"分享列表里根本找不到这个应用"。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享菜单。三个 filter 分别覆盖：分享文本、分享单个任意文件、
                 分享多个文件。只声明 text/plain 的话，从相册「分享」照片过来时
                 本应用根本不会出现在候选列表里——而那恰恰是手机上最常用的一种分享。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- 通知栏「同步剪贴板」按钮的落地页：全透明、不进最近任务列表、不留
             历史记录——它只为拿一次窗口焦点，见 ClipSyncTrampolineActivity 顶部说明。
             taskAffinity="" 让它落在自己独立的任务里，不会把 MainActivity 的
             任务栈带到前台，也不会打断用户当时正在用的其它 App。 -->
        <activity
            android:name=".ClipSyncTrampolineActivity"
            android:exported="false"
            android:theme="@style/Theme.Tessera.Transparent"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Tessera 键盘（输入法模式）。安卓 10 起只有当前默认输入法和前台应用读得到
             剪贴板，按包名判定：选用这个键盘时，SyncService 在后台也能读到复制的内容，
             手机上复制即自动同步。BIND_INPUT_METHOD 保证只有系统能绑定它。 -->
        <service
            android:name=".TesseraImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name=".SyncService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- 安装意图必须给 content:// URI。Android 7 起把 file:// 递给别的应用
             会直接抛 FileUriExposedException，而崩在这一步的表现是"点了更新没反应"。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
