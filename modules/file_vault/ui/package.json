{
  "name": "file-vault-ui",
  "private": true,
  "license": "AGPL-3.0-only OR LicenseRef-Ideal1-Commercial",
  "version": "0.1.48",
  "description": "Multi-factor encrypted vault for Windows",
  "author": "Aevorine",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "prebuild": "node scripts/build-file-hook.mjs",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:standalone": "node scripts/build-standalone.mjs",
    "signing:key": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File scripts/signing-key-gui.ps1",
    "signing:secure": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File scripts/secure-signing-key.ps1",
    "signing:password": "powershell.exe -NoProfile -ExecutionPolicy Bypass -STA -File scripts/signing-key-password.ps1 -Reveal -Gui",
    "signing:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-signing-key.ps1",
    "notices": "node scripts/gen-third-party-notices.mjs",
    "notices:check": "node scripts/gen-third-party-notices.mjs --check",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "test:update": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "test:unit": "vitest run",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 && node scripts/check-i18n-keys.mjs",
    "preview": "vite preview",
    "probe": "node scripts/layout-probe.mjs"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.9",
    "@tanstack/react-virtual": "^3.14.6",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "docx": "^9.5.1",
    "dompurify": "^3.4.16",
    "i18next": "^26.3.6",
    "katex": "^0.18.4",
    "lucide-react": "^1.23.0",
    "markdown-it": "^14.3.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.2.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "http-cache-semantics": "^4.3.0",
    "@xmldom/xmldom": "^0.8.15",
    "js-yaml": "^4.3.2",
    "brace-expansion@1": "^1.1.21",
    "brace-expansion@2": "^2.1.7",
    "brace-expansion@5": "^5.0.12",
    "undici@6": "^6.28.1",
    "undici@7": "^7.29.1"
  }
}
